{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "kunden-modern": {
        "ClusterId": "modern",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/kunden/{**rest}"
        }
      },
      "login-modern": {
        "ClusterId": "modern",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/login"
        }
      },
      "logout-modern": {
        "ClusterId": "modern",
        "Order": 1,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/logout"
        }
      },
      "rechnungen-legacy": {
        "ClusterId": "legacy",
        "Order": 50,
        "AuthorizationPolicy": "NurAdmin",
        "Match": {
          "Path": "/api/rechnungen/{**rest}"
        }
      },
      "api-legacy": {
        "ClusterId": "legacy",
        "Order": 90,
        "AuthorizationPolicy": "Angemeldet",
        "Match": {
          "Path": "/api/{**rest}"
        }
      },
      "frontend-legacy": {
        "ClusterId": "legacy",
        "Order": 100,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "{**rest}"
        }
      }
    },
    "Clusters": {
      "modern": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5080/"
          }
        }
      },
      "legacy": {
        "Destinations": {
          "iis": {
            "Address": "http://localhost:51400/"
          }
        }
      }
    }
  },
  "Sicherheit": {
    "AnmeldungErforderlich": false
  }
}
